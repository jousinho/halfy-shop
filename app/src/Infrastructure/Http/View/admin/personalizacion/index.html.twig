{% extends 'admin/layout.html.twig' %}

{% block title %}Personalización{% endblock %}

{% block content %}
    <div class="admin-page-header">
        <h1>Personalización</h1>
        <p class="admin-page-subtitle">Ajusta la identidad visual de la web.</p>
    </div>

    <div class="admin-section">
        <h2 class="admin-section__title">Logo de la web</h2>
        <p class="admin-section__desc">Se mostrará en el header en lugar del nombre de texto. Recomendado: PNG con fondo transparente.</p>

        {% if siteLogo %}
            <div class="logo-preview">
                <img src="/uploads/logo/{{ siteLogo }}" alt="Logo actual" class="logo-preview__img">
                <p class="logo-preview__caption">Logo actual</p>
            </div>
        {% else %}
            <p class="admin-section__empty">No hay logo configurado. Se muestra el nombre de texto.</p>
        {% endif %}

        <form method="post" action="{{ path('admin_personalizacion_logo') }}" enctype="multipart/form-data" class="admin-form">
            <input type="hidden" name="_token" value="{{ csrf_token('update_logo') }}">
            <div class="form-group">
                <label for="logo" class="form-label">{{ siteLogo ? 'Cambiar logo' : 'Subir logo' }}</label>
                <input type="file" id="logo" name="logo" accept="image/png,image/jpeg,image/webp" class="form-input" required>
            </div>
            <div class="form-actions">
                <button type="submit" class="btn btn--primary">Guardar logo</button>
            </div>
        </form>
    </div>


    <div class="admin-section">
        <h2 class="admin-section__title">Favicon</h2>
        <p class="admin-section__desc">Icono que aparece en la pestaña del navegador. Recomendado: PNG o ICO, 32×32 px.</p>

        {% if siteFavicon %}
            <div class="logo-preview">
                <img src="/uploads/favicon/{{ siteFavicon }}" alt="Favicon actual" class="favicon-preview__img">
                <p class="logo-preview__caption">Favicon actual</p>
            </div>
        {% else %}
            <p class="admin-section__empty">No hay favicon configurado. El navegador usará el icono por defecto.</p>
        {% endif %}

        <form method="post" action="{{ path('admin_personalizacion_favicon') }}" enctype="multipart/form-data" class="admin-form">
            <input type="hidden" name="_token" value="{{ csrf_token('update_favicon') }}">
            <div class="form-group">
                <label for="favicon" class="form-label">{{ siteFavicon ? 'Cambiar favicon' : 'Subir favicon' }}</label>
                <input type="file" id="favicon" name="favicon" accept="image/png,image/x-icon,image/vnd.microsoft.icon,image/svg+xml" class="form-input" required>
            </div>
            <div class="form-actions">
                <button type="submit" class="btn btn--primary">Guardar favicon</button>
            </div>
        </form>
    </div>

    <div class="admin-section">
        <h2 class="admin-section__title">Under Construction</h2>
        <p class="admin-section__desc">Activa el modo mantenimiento para mostrar la página de "próximamente" a los visitantes. El admin siempre tiene acceso.</p>

        <form method="post" action="{{ path('admin_personalizacion_maintenance') }}" class="admin-form" style="margin-bottom: 1.5rem;">
            <input type="hidden" name="_token" value="{{ csrf_token('update_maintenance') }}">
            <div class="form-group" style="display: flex; align-items: center; gap: 0.75rem;">
                <input type="checkbox" id="maintenance_mode" name="maintenance_mode" value="1" {% if maintenanceMode %}checked{% endif %}>
                <label for="maintenance_mode" class="form-label" style="margin: 0;">Activar modo mantenimiento</label>
            </div>
            <div class="form-actions">
                <button type="submit" class="btn btn--primary">Guardar</button>
            </div>
        </form>

        <form method="post" action="{{ path('admin_personalizacion_maintenance_text') }}" class="admin-form" id="maintenance-text-form" style="margin-bottom: 2rem;">
            <input type="hidden" name="_token" value="{{ csrf_token('update_maintenance_text') }}">
            <div class="form-group">
                <label class="form-label">Texto de la página</label>
                <div class="wysiwyg-toolbar">
                    <button type="button" data-cmd="bold"><b>N</b></button>
                    <button type="button" data-cmd="italic"><i>C</i></button>
                    <button type="button" data-cmd="underline"><u>S</u></button>
                    <div class="wysiwyg-sep"></div>
                    <button type="button" id="btn-link">&#128279; Enlace</button>
                    <button type="button" data-cmd="unlink">Quitar enlace</button>
                    <div class="wysiwyg-sep"></div>
                    <button type="button" data-cmd="removeFormat">Limpiar</button>
                </div>
                <div id="maintenance-wysiwyg" contenteditable="true" class="wysiwyg-editor-area">{{ maintenanceText|raw }}</div>
                <textarea id="maintenance_text" name="maintenance_text" style="display:none"></textarea>
            </div>
            <div class="form-actions">
                <button type="submit" class="btn btn--primary">Guardar texto</button>
            </div>
        </form>

        <p class="admin-section__desc">Imagen que se muestra en la página de mantenimiento.</p>

        {% if maintenanceImage %}
            <div class="logo-preview">
                <img src="/uploads/maintenance/{{ maintenanceImage }}" alt="Imagen actual" class="logo-preview__img" style="max-height: 120px;">
                <p class="logo-preview__caption">Imagen actual</p>
            </div>
        {% else %}
            <p class="admin-section__empty">No hay imagen configurada.</p>
        {% endif %}

        <form method="post" action="{{ path('admin_personalizacion_maintenance_image') }}" enctype="multipart/form-data" class="admin-form">
            <input type="hidden" name="_token" value="{{ csrf_token('update_maintenance_image') }}">
            <div class="form-group">
                <label for="maintenance_image" class="form-label">{{ maintenanceImage ? 'Cambiar imagen' : 'Subir imagen' }}</label>
                <input type="file" id="maintenance_image" name="maintenance_image" accept="image/png,image/jpeg,image/webp" class="form-input" required>
            </div>
            <div class="form-actions">
                <button type="submit" class="btn btn--primary">Guardar imagen</button>
            </div>
        </form>
    </div>

    <style>
        .admin-section { margin-top: 2rem; }
        .admin-section__title { font-size: 1rem; font-weight: 600; margin-bottom: 0.4rem; }
        .admin-section__desc  { font-size: 0.85rem; color: #666; margin-bottom: 1.25rem; }
        .admin-section__empty { font-size: 0.85rem; color: #999; margin-bottom: 1.25rem; font-style: italic; }
        .logo-preview { margin-bottom: 1.5rem; }
        .logo-preview__img { max-height: 80px; display: block; }
        .logo-preview__caption { font-size: 0.75rem; color: #999; margin-top: 0.4rem; }
        .favicon-preview__img { max-height: 48px; display: block; image-rendering: pixelated; }

        .wysiwyg-toolbar { display: flex; align-items: center; gap: 4px; padding: 6px 8px; background: #f5f5f5; border: 1px solid #ddd; border-bottom: none; border-radius: 4px 4px 0 0; flex-wrap: wrap; }
        .wysiwyg-toolbar button { background: none; border: 1px solid transparent; border-radius: 3px; padding: 3px 8px; cursor: pointer; font-size: 0.85rem; line-height: 1; color: #333; }
        .wysiwyg-toolbar button:hover { background: #e0e0e0; border-color: #ccc; }
        .wysiwyg-sep { width: 1px; height: 20px; background: #ccc; margin: 0 4px; }
        .wysiwyg-editor-area { min-height: 120px; padding: 10px 12px; border: 1px solid #ddd; border-radius: 0 0 4px 4px; outline: none; font-size: 0.85rem; line-height: 1.6; background: #fff; }
        .wysiwyg-editor-area a { color: #2a5bda; text-decoration: underline; }
    </style>

    <script>
    (function () {
        const editor   = document.getElementById('maintenance-wysiwyg');
        const textarea = document.getElementById('maintenance_text');
        const form     = document.getElementById('maintenance-text-form');

        document.querySelectorAll('.wysiwyg-toolbar [data-cmd]').forEach(btn => {
            btn.addEventListener('mousedown', e => {
                e.preventDefault();
                document.execCommand(btn.dataset.cmd, false, null);
                editor.focus();
            });
        });

        document.getElementById('btn-link').addEventListener('mousedown', e => {
            e.preventDefault();
            const url = prompt('URL del enlace (incluye https://)');
            if (url) {
                document.execCommand('createLink', false, url);
                editor.querySelectorAll('a').forEach(a => {
                    a.setAttribute('target', '_blank');
                    a.setAttribute('rel', 'noopener');
                });
            }
            editor.focus();
        });

        form.addEventListener('submit', () => {
            textarea.value = editor.innerHTML;
        });
    })();
    </script>
{% endblock %}
