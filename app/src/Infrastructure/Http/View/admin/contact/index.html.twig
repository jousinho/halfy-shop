{% extends 'admin/layout.html.twig' %}

{% block title %}Contacto{% endblock %}

{% block content %}
    <div class="admin-page-header">
        <h1>Contacto</h1>
        <p class="admin-page-subtitle">Contenido de la página de contacto.</p>
    </div>

    <div class="admin-section">
        <h2 class="admin-section__title">Imagen</h2>
        <p class="admin-section__desc">Imagen central que se muestra en la página de contacto.</p>

        {% if contactImage %}
            <div class="contact-preview">
                <img src="/uploads/contact/{{ contactImage }}" alt="Imagen de contacto" class="contact-preview__img">
                <p class="contact-preview__caption">Imagen actual</p>
            </div>
        {% else %}
            <p class="admin-section__empty">No hay imagen configurada.</p>
        {% endif %}

        <form method="post" action="{{ path('admin_contact_image') }}" enctype="multipart/form-data" class="admin-form">
            <input type="hidden" name="_token" value="{{ csrf_token('update_contact_image') }}">
            <div class="form-group">
                <label for="contact_image" class="form-label">{{ contactImage ? 'Cambiar imagen' : 'Subir imagen' }}</label>
                <input type="file" id="contact_image" name="contact_image" accept="image/png,image/jpeg,image/webp" class="form-input" required>
            </div>
            <div class="form-actions">
                <button type="submit" class="btn btn--primary">Guardar imagen</button>
            </div>
        </form>
    </div>

    <div class="admin-section">
        <h2 class="admin-section__title">Email de contacto</h2>
        <p class="admin-section__desc">Se mostrará como enlace en la página de contacto.</p>

        <form method="post" action="{{ path('admin_contact_email') }}" class="admin-form">
            <input type="hidden" name="_token" value="{{ csrf_token('update_contact_email') }}">
            <div class="form-group">
                <label for="contact_email" class="form-label">Email</label>
                <input type="email" id="contact_email" name="contact_email"
                       value="{{ contactEmail ?? '' }}"
                       placeholder="hola@ejemplo.com"
                       class="form-input">
            </div>
            <div class="form-actions">
                <button type="submit" class="btn btn--primary">Guardar email</button>
            </div>
        </form>
    </div>

    <style>
        .admin-section { margin-top: 2rem; }
        .admin-section__title { font-size: 1rem; font-weight: 600; margin-bottom: 0.4rem; }
        .admin-section__desc  { font-size: 0.85rem; color: #666; margin-bottom: 1.25rem; }
        .admin-section__empty { font-size: 0.85rem; color: #999; margin-bottom: 1.25rem; font-style: italic; }
        .contact-preview { margin-bottom: 1.5rem; }
        .contact-preview__img { max-height: 200px; display: block; }
        .contact-preview__caption { font-size: 0.75rem; color: #999; margin-top: 0.4rem; }
    </style>
{% endblock %}
