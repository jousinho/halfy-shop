<div class="theme-preview" style="background:#fdfcfa;">
    <div class="theme-preview__inner">
        <div style="text-align:center; padding: 18px 24px 12px; border-bottom: 1px solid #e5e2dd;">
            <div style="font-family:Georgia,serif; font-size:22px; letter-spacing:0.12em; text-transform:uppercase; color:#1a1a1a; margin-bottom:10px;">Anna Pownall</div>
            <div style="display:flex; justify-content:center; gap:32px;">
                <span style="font-size:9px; letter-spacing:0.2em; text-transform:uppercase; color:#1a1a1a; border-bottom:1px solid #1a1a1a; padding-bottom:2px;">Obras</span>
                <span style="font-size:9px; letter-spacing:0.2em; text-transform:uppercase; color:#9a9590;">Blog</span>
                <span style="font-size:9px; letter-spacing:0.2em; text-transform:uppercase; color:#9a9590;">Sobre mí</span>
            </div>
        </div>
        <div style="display:flex; justify-content:center; gap:24px; padding:14px 24px 0;">
            <span style="font-size:8px; letter-spacing:0.16em; text-transform:uppercase; color:#1a1a1a; border-bottom:1px solid #1a1a1a; padding-bottom:2px;">Todas</span>
            <span style="font-size:8px; letter-spacing:0.16em; text-transform:uppercase; color:#9a9590;">Grabado</span>
            <span style="font-size:8px; letter-spacing:0.16em; text-transform:uppercase; color:#9a9590;">Print</span>
            <span style="font-size:8px; letter-spacing:0.16em; text-transform:uppercase; color:#9a9590;">Original</span>
        </div>
        <div style="display:grid; grid-template-columns:repeat(4,1fr); gap:10px 8px; padding:14px 24px 20px;">
            {% set cards = [
                {bg:'#e2ddd7', h:'68px'},
                {bg:'#cdc8c2', h:'80px'},
                {bg:'#d8d3cc', h:'72px'},
                {bg:'#c8c3bb', h:'76px'},
            ] %}
            {% for card in cards %}
            <div>
                <div style="background:{{ card.bg }}; height:{{ card.h }}; border-radius:1px;"></div>
                <div style="height:6px; background:#d0ccc6; border-radius:1px; margin:5px 0 3px; width:70%;"></div>
                <div style="height:5px; background:#e5e2dd; border-radius:1px; width:40%;"></div>
            </div>
            {% endfor %}
        </div>
    </div>
</div>

<style>
.theme-preview { width:100%; height:180px; overflow:hidden; border-radius:4px 4px 0 0; position:relative; }
.theme-preview__inner { width:620px; transform:scale(0.42); transform-origin:top left; pointer-events:none; }
</style>
