<div style="
    width:100%; height:100%;
    background:#f0ebe0;
    font-family:'Georgia',serif;
    overflow:hidden;
    transform-origin:top left;
    position:relative;
">
    <!-- Header -->
    <div style="text-align:center; padding:10px 8px 6px; border-bottom:1px solid #ddd5c4;">
        <div style="font-size:11px; font-weight:600; color:#2c2416; letter-spacing:0.02em;">Anna Pownall</div>
        <div style="display:flex; justify-content:center; gap:10px; margin-top:4px;">
            <span style="font-size:5px; letter-spacing:0.12em; text-transform:uppercase; color:#9c8e78;">Obras</span>
            <span style="font-size:5px; letter-spacing:0.12em; text-transform:uppercase; color:#9c8e78;">Blog</span>
            <span style="font-size:5px; letter-spacing:0.12em; text-transform:uppercase; color:#9c8e78;">Sobre mí</span>
        </div>
    </div>
    <!-- Filters -->
    <div style="display:flex; justify-content:center; gap:4px; padding:5px 6px;">
        <span style="font-size:4px; background:#2c2416; color:#fffef9; border:1px solid #2c2416; border-radius:10px; padding:1px 5px; letter-spacing:0.1em; text-transform:uppercase;">Todas</span>
        <span style="font-size:4px; background:#fffef9; color:#9c8e78; border:1px solid #ddd5c4; border-radius:10px; padding:1px 5px; letter-spacing:0.1em; text-transform:uppercase;">Grabado</span>
        <span style="font-size:4px; background:#fffef9; color:#9c8e78; border:1px solid #ddd5c4; border-radius:10px; padding:1px 5px; letter-spacing:0.1em; text-transform:uppercase;">Print</span>
    </div>
    <!-- Polaroid grid -->
    <div style="display:grid; grid-template-columns:repeat(4,1fr); gap:6px; padding:4px 8px;">
        {% for angle in [-2.2, 1.4, -0.8, 2.1, -1.6, 0.9, -1.9, 1.2] %}
        <div style="
            background:#fffef9;
            padding:4px 4px 12px;
            box-shadow:2px 3px 6px rgba(44,36,22,0.18);
            transform:rotate({{ angle }}deg);
        ">
            <div style="background:#ddd5c4; aspect-ratio:1;"></div>
            <div style="text-align:center; margin-top:3px;">
                <div style="font-size:4px; color:#2c2416; font-style:italic;">Obra</div>
            </div>
        </div>
        {% endfor %}
    </div>
</div>
