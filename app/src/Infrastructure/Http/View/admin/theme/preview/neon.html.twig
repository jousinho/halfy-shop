<div style="
    width:100%; height:100%;
    background:#050505;
    font-family:'Courier New',monospace;
    overflow:hidden;
    position:relative;
">
    <!-- Scanlines overlay -->
    <div style="
        position:absolute; inset:0;
        background:repeating-linear-gradient(0deg,transparent,transparent 2px,rgba(0,255,136,0.015) 2px,rgba(0,255,136,0.015) 4px);
        pointer-events:none; z-index:10;
    "></div>
    <!-- Header -->
    <div style="
        background:#050505;
        border-bottom:1px solid #00ff88;
        box-shadow:0 0 8px rgba(0,255,136,0.15);
        display:flex; align-items:center; justify-content:space-between;
        padding:0 8px; height:18px;
    ">
        <span style="font-size:5px; font-weight:700; letter-spacing:0.18em; text-transform:uppercase; color:#00ff88; text-shadow:0 0 6px rgba(0,255,136,0.6);">Anna Pownall</span>
        <div style="display:flex; gap:8px;">
            <span style="font-size:4px; letter-spacing:0.12em; text-transform:uppercase; color:#555550;">Obras</span>
            <span style="font-size:4px; letter-spacing:0.12em; text-transform:uppercase; color:#555550;">Blog</span>
        </div>
    </div>
    <!-- Filters bar -->
    <div style="
        display:flex; align-items:center;
        border-bottom:1px solid #1a1a18;
        height:12px; padding:0 8px; gap:0;
    ">
        <span style="font-size:4px; letter-spacing:0.1em; text-transform:uppercase; color:#00ff88; padding:0 6px; background:rgba(0,255,136,0.04);">Todas</span>
        <span style="font-size:4px; letter-spacing:0.1em; text-transform:uppercase; color:#555550; padding:0 6px; border-left:1px solid #1a1a18;">Grabado</span>
        <span style="font-size:4px; letter-spacing:0.1em; text-transform:uppercase; color:#555550; padding:0 6px; border-left:1px solid #1a1a18;">Print</span>
        <span style="font-size:4px; letter-spacing:0.1em; text-transform:uppercase; color:#555550; padding:0 6px; border-left:1px solid #1a1a18;">Original</span>
    </div>
    <!-- Grid -->
    <div style="display:grid; grid-template-columns:repeat(4,1fr); gap:1px; padding:1px;">
        {% for i in 1..8 %}
        <div style="aspect-ratio:1; background:#0d0d0d; position:relative; overflow:hidden;">
            <div style="width:100%; height:100%; background:linear-gradient(135deg,#1a1a18,#0d0d0d);"></div>
            <div style="
                position:absolute; inset:0;
                border:1px solid transparent;
            "></div>
        </div>
        {% endfor %}
    </div>
</div>
