<div class="theme-preview" style="background:#0e0e0e;">
    <div class="theme-preview__inner">
        <div style="display:flex; align-items:center; justify-content:space-between; padding:0 24px; height:44px; border-bottom:1px solid #2a2825; background:#0e0e0e;">
            <span style="font-size:9px; font-weight:500; letter-spacing:0.22em; text-transform:uppercase; color:#ddd8ce;">Anna Pownall</span>
            <div style="display:flex; gap:20px;">
                <span style="font-size:8px; letter-spacing:0.16em; text-transform:uppercase; color:#b89a6e;">Obras</span>
                <span style="font-size:8px; letter-spacing:0.16em; text-transform:uppercase; color:#6e6860;">Blog</span>
                <span style="font-size:8px; letter-spacing:0.16em; text-transform:uppercase; color:#6e6860;">Sobre mí</span>
            </div>
        </div>
        <div style="display:flex; border-bottom:1px solid #2a2825; height:32px; align-items:center;">
            <span style="font-size:8px; letter-spacing:0.14em; text-transform:uppercase; color:#b89a6e; padding:0 16px; border-right:1px solid #2a2825; height:100%; display:flex; align-items:center;">Todas</span>
            <span style="font-size:8px; letter-spacing:0.14em; text-transform:uppercase; color:#6e6860; padding:0 16px; border-right:1px solid #2a2825; height:100%; display:flex; align-items:center;">Grabado</span>
            <span style="font-size:8px; letter-spacing:0.14em; text-transform:uppercase; color:#6e6860; padding:0 16px; border-right:1px solid #2a2825; height:100%; display:flex; align-items:center;">Print</span>
            <span style="font-size:8px; letter-spacing:0.14em; text-transform:uppercase; color:#6e6860; padding:0 16px; height:100%; display:flex; align-items:center;">Original</span>
        </div>
        <div style="columns:3; column-gap:3px; padding:3px;">
            {% set imgs = [
                {bg:'#2a2520', h:'90px'},
                {bg:'#1e1c19', h:'60px'},
                {bg:'#252220', h:'75px'},
                {bg:'#1a1815', h:'55px'},
                {bg:'#222018', h:'80px'},
                {bg:'#282420', h:'65px'},
            ] %}
            {% for img in imgs %}
            <div style="background:{{ img.bg }}; height:{{ img.h }}; margin-bottom:3px; break-inside:avoid;"></div>
            {% endfor %}
        </div>
    </div>
</div>

<style>
.theme-preview { width:100%; height:180px; overflow:hidden; border-radius:4px 4px 0 0; position:relative; }
.theme-preview__inner { width:620px; transform:scale(0.42); transform-origin:top left; pointer-events:none; }
</style>
