<div style="
    width:100%; height:100%;
    background:#f7f4ef;
    font-family:'Georgia',serif;
    overflow:hidden;
    display:flex;
    flex-direction:column;
">
    <!-- Masthead -->
    <div style="
        background:#1a1611;
        padding:8px 10px 6px;
        text-align:center;
        border-bottom:2px solid #c0392b;
        flex-shrink:0;
    ">
        <div style="font-size:4px; letter-spacing:0.25em; text-transform:uppercase; color:#8a8070; margin-bottom:3px;">Obra gráfica e ilustración</div>
        <div style="font-size:10px; color:#fffffe; letter-spacing:-0.02em;">Anna <em>Pownall</em></div>
        <div style="width:14px; height:1px; background:#c0392b; margin:4px auto;"></div>
        <div style="display:flex; justify-content:center; gap:8px;">
            <span style="font-size:4px; letter-spacing:0.2em; text-transform:uppercase; color:#8a8070;">Obras</span>
            <span style="font-size:4px; letter-spacing:0.2em; text-transform:uppercase; color:#8a8070;">Blog</span>
            <span style="font-size:4px; letter-spacing:0.2em; text-transform:uppercase; color:#8a8070;">Sobre mí</span>
        </div>
    </div>
    <!-- Body with sidebar -->
    <div style="display:flex; flex:1; overflow:hidden;">
        <!-- Sidebar -->
        <div style="
            width:55px; flex-shrink:0;
            background:#fffffe;
            border-right:1px solid #d4cdc0;
            padding:8px 6px;
        ">
            <div style="font-size:3.5px; letter-spacing:0.2em; text-transform:uppercase; color:#8a8070; padding-bottom:3px; border-bottom:1px solid #d4cdc0; margin-bottom:4px;">Categorías</div>
            <div style="font-size:5px; color:#1a1611; padding:2px 0; border-bottom:1px solid #d4cdc0; font-weight:600;">Todas las obras</div>
            <div style="font-size:5px; color:#8a8070; padding:2px 0; border-bottom:1px solid #d4cdc0; position:relative;">
                <span style="position:absolute; left:-6px; top:50%; transform:translateY(-50%); width:2px; height:60%; background:#c0392b;"></span>
                Grabado
            </div>
            <div style="font-size:5px; color:#8a8070; padding:2px 0; border-bottom:1px solid #d4cdc0;">Ilustración</div>
            <div style="font-size:5px; color:#8a8070; padding:2px 0; border-bottom:1px solid #d4cdc0;">Print</div>
        </div>
        <!-- Content -->
        <div style="flex:1; padding:8px 10px; overflow:hidden;">
            <div style="display:flex; align-items:baseline; justify-content:space-between; border-bottom:1.5px solid #1a1611; padding-bottom:4px; margin-bottom:6px;">
                <span style="font-size:7px; font-style:italic; color:#1a1611;">Todas las obras</span>
                <span style="font-size:3.5px; letter-spacing:0.15em; text-transform:uppercase; color:#8a8070;">12 piezas</span>
            </div>
            <div style="display:grid; grid-template-columns:repeat(3,1fr); gap:6px;">
                {% for i in 1..6 %}
                <div>
                    <div style="aspect-ratio:3/4; background:#d4cdc0;"></div>
                    <div style="padding:3px 0; border-bottom:1px solid #d4cdc0;">
                        <div style="font-size:4.5px; font-style:italic; color:#1a1611;">Obra {{ i }}</div>
                        <div style="font-size:3.5px; color:#8a8070; margin-top:1px;">120,00 €</div>
                    </div>
                </div>
                {% endfor %}
            </div>
        </div>
    </div>
</div>
