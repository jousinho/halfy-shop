{% extends 'admin/layout.html.twig' %}

{% block title %}{{ novedad is null ? 'Nueva novedad' : 'Editar novedad' }}{% endblock %}

{% block content %}
    <div class="admin-page-header">
        <h1>{{ novedad is null ? 'Nueva novedad' : 'Editar: ' ~ novedad.titulo }}</h1>
        <a href="{{ path('admin_novedades') }}" class="btn btn--secondary">← Volver</a>
    </div>

    <form method="post"
          enctype="multipart/form-data"
          action="{{ novedad is null ? path('admin_novedades_create') : path('admin_novedades_update', {id: novedad.id.value}) }}"
          class="admin-form">

        <div class="form-row">
            <div class="form-group">
                <label for="titulo">Título (ES) *</label>
                <input type="text" id="titulo" name="titulo" required
                       value="{{ novedad is not null ? novedad.titulo : '' }}">
            </div>
            <div class="form-group">
                <label for="tituloEn">
                    Título (EN)
                    <button type="button" class="btn-translate" data-src="titulo" data-dst="tituloEn">Traducir →</button>
                </label>
                <input type="text" id="tituloEn" name="tituloEn"
                       value="{{ novedad is not null and novedad.tituloEn is not null ? novedad.tituloEn : '' }}">
            </div>
        </div>

        <div class="form-row">
            <div class="form-group">
                <label for="tipo">Tipo *</label>
                <select id="tipo" name="tipo" required>
                    <option value="noticia" {{ novedad is null or novedad.tipo.value == 'noticia' ? 'selected' : '' }}>Noticia</option>
                    <option value="evento" {{ novedad is not null and novedad.tipo.value == 'evento' ? 'selected' : '' }}>Evento</option>
                </select>
            </div>
            <div class="form-group evento-only" style="display:none">
                <label for="lugar">Lugar</label>
                <input type="text" id="lugar" name="lugar"
                       value="{{ novedad is not null and novedad.lugar is not null ? novedad.lugar : '' }}">
            </div>
        </div>

        <div class="form-row">
            <div class="form-group">
                <label for="fecha">Fecha inicio *</label>
                <input type="date" id="fecha" name="fecha" required
                       value="{{ novedad is not null ? novedad.fecha|date('Y-m-d') : '' }}">
            </div>
            <div class="form-group evento-only" style="display:none">
                <label for="fechaFin">Fecha fin</label>
                <input type="date" id="fechaFin" name="fechaFin"
                       value="{{ novedad is not null and novedad.fechaFin is not null ? novedad.fechaFin|date('Y-m-d') : '' }}">
            </div>
        </div>

        <div class="form-group">
            <label for="imagenFile">
                Imagen
                {% if novedad is not null and novedad.imagen is not null %}
                    <small>(dejar vacío para mantener la actual)</small>
                {% endif %}
            </label>
            {% if novedad is not null and novedad.imagen is not null %}
                <div class="form-image-preview">
                    <img src="/uploads/novedades/{{ novedad.imagen }}" alt="">
                </div>
            {% endif %}
            <input type="file" id="imagenFile" name="imagenFile" accept="image/*">
        </div>

        <div class="form-group">
            <label for="url">Enlace externo</label>
            <input type="url" id="url" name="url"
                   value="{{ novedad is not null and novedad.url is not null ? novedad.url : '' }}">
        </div>

        <div class="form-row">
            <div class="form-group">
                <label for="videoYoutube">Vídeo YouTube</label>
                <input type="url" id="videoYoutube" name="videoYoutube"
                       placeholder="https://www.youtube.com/watch?v=..."
                       value="{{ novedad is not null and novedad.videoYoutube is not null ? novedad.videoYoutube : '' }}">
            </div>
            <div class="form-group">
                <label for="videoReel">Reel de Instagram</label>
                <input type="url" id="videoReel" name="videoReel"
                       placeholder="https://www.instagram.com/reel/..."
                       value="{{ novedad is not null and novedad.videoReel is not null ? novedad.videoReel : '' }}">
            </div>
        </div>

        <div class="form-group">
            <label for="contenido">Contenido (ES)</label>
            <textarea id="contenido" name="contenido" rows="6" class="wysiwyg">{{ novedad is not null and novedad.contenido is not null ? novedad.contenido : '' }}</textarea>
        </div>

        <div class="form-group">
            <label for="contenidoEn">
                Contenido (EN)
                <button type="button" class="btn-translate" data-src="contenido" data-dst="contenidoEn">Traducir →</button>
            </label>
            <textarea id="contenidoEn" name="contenidoEn" rows="6" class="wysiwyg">{{ novedad is not null and novedad.contenidoEn is not null ? novedad.contenidoEn : '' }}</textarea>
        </div>

        <div class="form-group form-group--check">
            <label>
                <input type="checkbox" name="publicado" value="1"
                       {{ novedad is null or novedad.publicado ? 'checked' : '' }}>
                Publicada
            </label>
        </div>

        <div class="form-actions">
            <button type="submit" class="btn btn--primary">
                {{ novedad is null ? 'Crear novedad' : 'Guardar cambios' }}
            </button>
        </div>
    </form>
{% endblock %}

{% block javascripts %}
<script src="https://cdn.jsdelivr.net/npm/tinymce@6/tinymce.min.js" referrerpolicy="origin"></script>
<script>
tinymce.init({
    selector: '.wysiwyg',
    menubar: false,
    plugins: 'lists link',
    toolbar: 'bold italic | bullist numlist | link',
    height: 250,
});

// Toggle campos de evento
const tipoSelect   = document.getElementById('tipo');
const eventoFields = document.querySelectorAll('.evento-only');

function toggleEventoFields() {
    const isEvento = tipoSelect.value === 'evento';
    eventoFields.forEach(el => el.style.display = isEvento ? '' : 'none');
}

tipoSelect.addEventListener('change', toggleEventoFields);
toggleEventoFields();

// Traductor
document.querySelectorAll('.btn-translate').forEach(btn => {
    btn.addEventListener('click', async () => {
        const srcId = btn.dataset.src;
        const dstId = btn.dataset.dst;
        const text  = tinymce.get(srcId) ? tinymce.get(srcId).getContent({format:'text'}) : document.getElementById(srcId).value;
        if (!text.trim()) return;

        btn.disabled    = true;
        btn.textContent = '…';

        try {
            const url  = 'https://translate.googleapis.com/translate_a/single?client=gtx&sl=es&tl=en&dt=t&q=' + encodeURIComponent(text);
            const res  = await fetch(url);
            const data = await res.json();
            const translated = data[0].map(s => s[0]).join('');
            if (tinymce.get(dstId)) tinymce.get(dstId).setContent(translated);
            else document.getElementById(dstId).value = translated;
        } catch (e) {
            alert('Error al traducir. Inténtalo de nuevo.');
        } finally {
            btn.disabled    = false;
            btn.textContent = 'Traducir →';
        }
    });
});
</script>
{% endblock %}
