{% extends 'admin/layout.html.twig' %}

{% block title %}{{ category is null ? 'Nueva categoría' : 'Editar categoría' }}{% endblock %}

{% block content %}
    <div class="admin-page-header">
        <h1>{{ category is null ? 'Nueva categoría' : 'Editar: ' ~ category.name.value }}</h1>
        <a href="{{ path('admin_categories') }}" class="btn btn--secondary">← Volver</a>
    </div>

    <form method="post"
          action="{{ category is null ? path('admin_categories_create') : path('admin_categories_update', {id: category.id.value}) }}"
          class="admin-form">

        <div class="form-row">
            <div class="form-group">
                <label for="name">Nombre (ES) *</label>
                <input type="text" id="name" name="name" required
                       value="{{ category is not null ? category.name.value : '' }}">
            </div>
            <div class="form-group">
                <label for="nameEn">
                    Nombre (EN)
                    <button type="button" class="btn-translate" data-src="name" data-dst="nameEn">Traducir →</button>
                </label>
                <input type="text" id="nameEn" name="nameEn"
                       value="{{ category is not null and category.nameEn is not null ? category.nameEn : '' }}">
            </div>
        </div>

        <div class="form-group">
            <label for="slug">Slug *</label>
            <input type="text" id="slug" name="slug" required
                   placeholder="ej. grabado"
                   value="{{ category is not null ? category.slug.value : '' }}">
            <small>Solo minúsculas y guiones. Se usa en la URL.</small>
        </div>

        <div class="form-actions">
            <button type="submit" class="btn btn--primary">
                {{ category is null ? 'Crear categoría' : 'Guardar cambios' }}
            </button>
        </div>
    </form>
{% endblock %}

{% block javascripts %}
<script>
document.querySelectorAll('.btn-translate').forEach(btn => {
    btn.addEventListener('click', async () => {
        const src  = document.getElementById(btn.dataset.src);
        const dst  = document.getElementById(btn.dataset.dst);
        const text = src.value.trim();
        if (!text) return;

        btn.disabled    = true;
        btn.textContent = '…';

        try {
            const url  = 'https://translate.googleapis.com/translate_a/single?client=gtx&sl=es&tl=en&dt=t&q=' + encodeURIComponent(text);
            const res  = await fetch(url);
            const data = await res.json();
            dst.value  = data[0].map(s => s[0]).join('');
        } catch (e) {
            alert('Error al traducir. Inténtalo de nuevo.');
        } finally {
            btn.disabled    = false;
            btn.textContent = 'Traducir →';
        }
    });
});
</script>
{% endblock %}
