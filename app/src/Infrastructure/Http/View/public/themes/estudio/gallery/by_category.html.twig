{% extends 'public/themes/estudio/layout.html.twig' %}

{% block title %}{{ activeCategory.name.value }} — Anna Pownall{% endblock %}

{% block content %}
    {% if categories is not empty %}
    <nav class="es-filters">
        <a href="{{ path('home') }}" class="es-filter">{{ 'filter.all'|trans }}</a>
        {% for cat in categories %}
        <a href="{{ path('gallery_by_category', {slug: cat.slug.value}) }}"
           class="es-filter {% if cat.id.value == activeCategory.id.value %}es-filter--active{% endif %}">
            {{ cat.name.value }}
        </a>
        {% endfor %}
    </nav>
    <select class="es-filters-select" onchange="window.location=this.value">
        <option value="{{ path('home') }}">{{ 'filter.all_categories'|trans }}</option>
        {% for cat in categories %}
        <option value="{{ path('gallery_by_category', {slug: cat.slug.value}) }}"
                {% if cat.id.value == activeCategory.id.value %}selected{% endif %}>
            {{ cat.name.value }}
        </option>
        {% endfor %}
    </select>
    {% endif %}

    {% if artworks is not empty %}
    <div class="es-masonry">
        {% for artwork in artworks %}
            {% include 'public/themes/estudio/home/_artwork_card.html.twig' with {artwork: artwork} %}
        {% endfor %}
    </div>
    {% else %}
        <p class="es-empty">{{ 'gallery.empty_category'|trans }}</p>
    {% endif %}
{% endblock %}
