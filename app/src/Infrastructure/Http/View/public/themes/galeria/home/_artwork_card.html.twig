<article class="gl-card">
    {% if artwork.imageFilename is not null %}
    <a href="/uploads/artworks/{{ artwork.imageFilename }}"
       class="glightbox gl-card__link"
       data-gallery="artworks"
       data-title="{{ artwork.titleForLocale(app.request.locale) }}"
       data-description="{% if artwork.techniqueForLocale(app.request.locale) is not null %}<span class='lb-technique'>{{ artwork.techniqueForLocale(app.request.locale) }}</span>{% endif %}{% if artwork.dimensions is not null %}<span class='lb-dimensions'>{{ artwork.dimensions.value }}</span>{% endif %}{% if artwork.year is not null %}<span class='lb-year'>{{ artwork.year.value }}</span>{% endif %}{% if artwork.price is not null %}<span class='lb-price'>{{ artwork.price.value }}€</span>{% endif %}{% if artwork.shopUrl is not null and artwork.isAvailable %}<a href='{{ artwork.shopUrl }}' target='_blank' class='lb-shop-link'>{{ 'shop.view'|trans }}</a>{% endif %}">
        <div class="gl-card__image-wrap">
            <img src="/uploads/artworks/thumbnails/{{ artwork.imageFilename }}"
                 alt="{{ artwork.titleForLocale(app.request.locale) }}"
                 loading="lazy"
                 class="gl-card__img">
        </div>
    </a>
    {% else %}
    <div class="gl-card__no-image"></div>
    {% endif %}
    <div class="gl-card__meta">
        <p class="gl-card__title">{{ artwork.titleForLocale(app.request.locale) }}</p>
        {% if artwork.isAvailable and artwork.price is not null %}
            <p class="gl-card__price">{{ artwork.price.value|number_format(2, ',', '.') }} €</p>
        {% elseif not artwork.isAvailable %}
            <p class="gl-card__sold">{{ 'badge.sold'|trans }}</p>
        {% endif %}
    </div>
</article>
