{% extends 'public/themes/galeria/layout.html.twig' %}

{% block title %}{{ activeCategory.nameForLocale(app.request.locale) }} — Anna Pownall{% endblock %}

{% block content %}
    {% if categories is not empty %}
    <nav class="gl-filters">
        <a href="{{ path('home') }}" class="gl-filter">{{ 'filter.all'|trans }}</a>
        {% for cat in categories %}
        <a href="{{ path('gallery_by_category', {slug: cat.slug.value}) }}"
           class="gl-filter {% if cat.id.value == activeCategory.id.value %}gl-filter--active{% endif %}">
            {{ cat.nameForLocale(app.request.locale) }}
        </a>
        {% endfor %}
    </nav>
    <select class="gl-filters-select" onchange="window.location=this.value">
        <option value="{{ path('home') }}">{{ 'filter.all_categories'|trans }}</option>
        {% for cat in categories %}
        <option value="{{ path('gallery_by_category', {slug: cat.slug.value}) }}"
                {% if cat.id.value == activeCategory.id.value %}selected{% endif %}>
            {{ cat.nameForLocale(app.request.locale) }}
        </option>
        {% endfor %}
    </select>
    {% endif %}

    <div class="gl-grid">
        {% for artwork in artworks %}
            {% include 'public/themes/galeria/home/_artwork_card.html.twig' with {artwork: artwork} %}
        {% else %}
            <p class="gl-empty">{{ 'gallery.empty_category'|trans }}</p>
        {% endfor %}
    </div>
{% endblock %}
