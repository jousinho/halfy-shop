{% extends 'public/themes/neon/layout.html.twig' %}

{% block title %}{{ activeCategory.name.value }} — Anna Pownall{% endblock %}

{% block content %}
    {% if categories is not empty %}
    <nav class="ne-filters">
        <a href="{{ path('home') }}" class="ne-filter">{{ 'filter.all'|trans }}</a>
        {% for cat in categories %}
        <a href="{{ path('gallery_by_category', {slug: cat.slug.value}) }}"
           class="ne-filter {% if cat.id.value == activeCategory.id.value %}ne-filter--active{% endif %}">
            {{ cat.name.value }}
        </a>
        {% endfor %}
    </nav>
    <select class="ne-filters-select" onchange="window.location=this.value">
        <option value="{{ path('home') }}">{{ 'filter.all_categories'|trans }}</option>
        {% for cat in categories %}
        <option value="{{ path('gallery_by_category', {slug: cat.slug.value}) }}"
                {% if cat.id.value == activeCategory.id.value %}selected{% endif %}>
            {{ cat.name.value }}
        </option>
        {% endfor %}
    </select>
    {% endif %}

    <div class="ne-grid">
        {% for artwork in artworks %}
            {% include 'public/themes/neon/home/_artwork_card.html.twig' with {artwork: artwork} %}
        {% else %}
            <p class="ne-empty">// {{ 'gallery.empty_category'|trans }}</p>
        {% endfor %}
    </div>
{% endblock %}
