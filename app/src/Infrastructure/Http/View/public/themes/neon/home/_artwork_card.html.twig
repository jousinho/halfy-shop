<div class="ne-card">
    <a href="/uploads/artworks/{{ artwork.imageFilename }}"
       class="glightbox ne-card__link"
       data-gallery="artworks"
       data-title="{{ artwork.titleForLocale(app.request.locale) }}"
       data-description="<span class='lb-technique'>{{ artwork.techniqueForLocale(app.request.locale) }}</span>{% if artwork.dimensions is not null %}<span class='lb-dimensions'>{{ artwork.dimensions.value }}</span>{% endif %}{% if artwork.year is not null %}<span class='lb-year'>{{ artwork.year.value }}</span>{% endif %}{% if artwork.price is not null %}<span class='lb-price'>{{ artwork.price.value }}€</span>{% endif %}{% if artwork.shopUrl is not null and artwork.isAvailable %}<a href='{{ artwork.shopUrl }}' target='_blank' class='lb-shop-link'>{{ 'shop.view'|trans }}</a>{% endif %}">
        <img src="/uploads/artworks/thumbnails/{{ artwork.imageFilename }}"
             alt="{{ artwork.titleForLocale(app.request.locale) }}"
             loading="lazy"
             class="ne-card__img">
        <div class="ne-card__glow"></div>
        <div class="ne-card__overlay">
            <p class="ne-card__title">{{ artwork.titleForLocale(app.request.locale) }}</p>
            {% if artwork.isAvailable and artwork.price is not null %}
                <p class="ne-card__price">{{ artwork.price.value|number_format(2, ',', '.') }} €</p>
            {% elseif not artwork.isAvailable %}
                <p class="ne-card__price">{{ 'badge.sold_neon'|trans }}</p>
            {% endif %}
        </div>
    </a>
</div>
