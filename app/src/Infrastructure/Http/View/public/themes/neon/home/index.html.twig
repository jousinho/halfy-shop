{% extends 'public/themes/neon/layout.html.twig' %}

{% block title %}{{ 'page.title'|trans }}{% endblock %}

{% block content %}
    {% if categories is not empty %}
    <nav class="ne-filters">
        <a href="{{ path('home') }}" class="ne-filter ne-filter--active">{{ 'filter.all'|trans }}</a>
        {% for category in categories %}
        <a href="{{ path('gallery_by_category', {slug: category.slug.value}) }}" class="ne-filter">
            {{ category.name.value }}
        </a>
        {% endfor %}
    </nav>
    <select class="ne-filters-select" onchange="window.location=this.value">
        <option value="{{ path('home') }}" selected>{{ 'filter.all_categories'|trans }}</option>
        {% for category in categories %}
        <option value="{{ path('gallery_by_category', {slug: category.slug.value}) }}">
            {{ category.name.value }}
        </option>
        {% endfor %}
    </select>
    {% endif %}

    <div class="ne-grid">
        {% for artwork in artworks %}
            {% include 'public/themes/neon/home/_artwork_card.html.twig' with {artwork: artwork} %}
        {% else %}
            <p class="ne-empty">// {{ 'gallery.empty'|trans }}</p>
        {% endfor %}
    </div>
{% endblock %}
